{
  "experiments": {
    "large_lateral_impulse": {
      "description": "Forward locomotion at 1.5 m/s under a large lateral ramp impulse. The paper reports FACET robustness up to about 200 Ns and trajectory examples at 400 N peak force.",
      "weight": 0.45,
      "primary_metric": "success_rate",
      "metrics": {
        "success_rate": {
          "higher_is_better": true,
          "coefficient": 1.0
        },
        "mean_final_forward_speed_mps": {
          "higher_is_better": true,
          "coefficient": 0.2
        }
      },
      "results": {
        "velocity_vanilla": {
          "type": "baseline",
          "success_rate": 0.0,
          "mean_final_forward_speed_mps": 1.5
        },
        "velocity_robust": {
          "type": "baseline",
          "success_rate": 0.0,
          "mean_final_forward_speed_mps": 1.5
        },
        "facet_smoothed": {
          "type": "proposed",
          "success_rate": 1.0,
          "mean_final_forward_speed_mps": 1.5
        }
      }
    },
    "soft_wall_collision": {
      "description": "Wall collision at 1.5 m/s. The paper reports that the compliant FACET setting reduces collision impulse by about 80% relative to the robust velocity baseline.",
      "weight": 0.30,
      "primary_metric": "collision_impulse_reduction",
      "metrics": {
        "collision_impulse_reduction": {
          "higher_is_better": true,
          "coefficient": 1.0
