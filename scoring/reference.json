{
  "experiments": {
    "large_lateral_impulse": {
      "description": "Forward locomotion at 1.5 m/s under a large lateral ramp impulse. The paper reports FACET robustness up to about 200 Ns and trajectory examples at 400 N peak force.",
      "weight": 0.60,
      "primary_metric": "impulse_recovery_score",
      "metrics": {
        "impulse_recovery_score": {
          "higher_is_better": true,
          "coefficient": 1.0
        },
        "success_rate": {
          "higher_is_better": true,
          "coefficient": 0.5
        },
        "mean_final_forward_speed_mps": {
          "higher_is_better": true,
          "coefficient": 0.2
        }
      },
      "results": {
        "velocity_vanilla": {
          "type": "baseline",
          "impulse_recovery_score": 0.0,
          "success_rate": 0.0,
          "mean_final_forward_speed_mps": 1.5
        },
        "velocity_robust": {
          "type": "baseline",
          "impulse_recovery_score": 0.0,
          "success_rate": 0.0,
          "mean_final_forward_speed_mps": 1.5
        },
        "facet_smoothed": {
          "type": "proposed",
          "impulse_recovery_score": 0.5835,
          "success_rate": 1.0,
          "mean_final_forward_speed_mps": 1.5
        }
      }
    },
    "soft_wall_collision": {
      "description": "Wall collision at 1.5 m/s. The paper reports that the compliant FACET setting reduces collision impulse by about 80% relative to the robust velocity baseline.",
      "weight": 0.40,
      "primary_metric": "post_contact_impulse_reduction",
      "metrics": {
        "post_contact_impulse_reduction": {
          "higher_is_better": true,
          "coefficient": 1.0
        },
        "collision_impulse_reduction": {
          "higher_is_better": true,
          "coefficient": 0.5
        },
        "wall_contact_rate": {
          "higher_is_better": true,
          "coefficient": 0.0
        },
        "mean_wall_entry_speed_mps": {
          "higher_is_better": true,
          "coefficient": 0.3
        }
      },
      "results": {
        "velocity_robust": {
          "type": "baseline",
          "post_contact_impulse_reduction": 0.0,
          "collision_impulse_reduction": 0.0,
          "wall_contact_rate": 1.0
        },
        "facet_low_kp": {
          "type": "proposed",
          "post_contact_impulse_reduction": 0.412,
          "collision_impulse_reduction": 0.8,
          "wall_contact_rate": 1.0
        }
      }
    }
  }
}
